{
  "name": "veramo-site-docs",
  "version": "7.0.0",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production HTTPS=true docusaurus serve --port $PORT",
    "dev": "docusaurus start",
    "serve": "docusaurus serve",
    "docusaurus": "docusaurus",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "build:veramo": "bash ./scripts/build-veramo.sh",
    "check:codeblocks": "bash scripts/check-codeblocks.sh",
    "baseline:docs": "bash scripts/check-codeblocks.sh --report",
    "check:all": "pnpm run build:veramo && pnpm run format && pnpm run check:docs && pnpm run build",
    "format": "prettier --write '{src,docs}/**/*'"
  },
  "dependencies": {
    "@algolia/client-search": "^4.17.0",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "did-resolver": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@docusaurus/faster": "^3.9.2",
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@microsoft/api-documenter": "^7.29.5",
    "@microsoft/api-extractor": "^7.57.5",
    "@tsconfig/docusaurus": "^2.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.23",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router-dom": "^5.3.3",
    "fs-extra": "^11.3.3",
    "glob": "^11.0.0",
    "path": "^0.12.7",
    "prettier": "^3.8.1",
    "react-github-btn": "^1.4.0",
    "readline": "^1.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
